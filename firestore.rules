rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /documents/{docId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
    match /chat_history/{chatId} {
      allow read, write: if true;
    }
    match /analytics/{analyticsId} {
      allow read, write: if true;
    }
    match /test/{testId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
